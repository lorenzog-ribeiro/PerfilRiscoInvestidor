# Database
DATABASE_URL="postgresql://user:password@localhost:5432/perfil_risco?schema=public"

# Application
NODE_ENV=production
PORT=3333

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Admin API key — required to access admin endpoints (ex: GET /answers/all)
# via header `x-admin-key`. Se vazio, esses endpoints ficam bloqueados.
ADMIN_API_KEY=

# PostgreSQL (if using docker-compose with postgres)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=perfil_risco
